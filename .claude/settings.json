{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go list *)",
      "Bash(go mod verify)",
      "Bash(go mod tidy -diff)",
      "Bash(go tool cover *)",
      "Bash(gofmt -l *)",
      "Bash(gofmt -d *)",
      "Bash(golangci-lint run *)",
      "Bash(staticcheck *)",
      "Bash(govulncheck *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File scripts\\check.ps1 *)"
    ],
    "ask": [
      "Bash(*zapret-manager.exe install*)",
      "Bash(*zapret-manager.exe select*)",
      "Bash(*zapret-manager.exe use*)",
      "Bash(*zapret-manager.exe update*)",
      "Bash(*zapret-manager.exe hosts*)",
      "Bash(*zapret-manager.exe off*)",
      "Bash(*zapret-manager.exe on*)",
      "Bash(*zapret-manager.exe doctor*)",
      "PowerShell(*zapret-manager.exe install*)",
      "PowerShell(*zapret-manager.exe select*)",
      "PowerShell(*zapret-manager.exe use*)",
      "PowerShell(*zapret-manager.exe update*)",
      "PowerShell(*zapret-manager.exe hosts*)",
      "PowerShell(*zapret-manager.exe off*)",
      "PowerShell(*zapret-manager.exe on*)",
      "Bash(sc *)",
      "Bash(sc.exe *)",
      "Bash(netsh *)",
      "PowerShell(Stop-Service *)",
      "PowerShell(Set-Service *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(*zapret-manager.exe uninstall*)",
      "PowerShell(*zapret-manager.exe uninstall*)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Read(**/.env)",
      "Edit(//c/Windows/System32/drivers/etc/hosts)"
    ]
  }
}
